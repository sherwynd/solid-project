PORT=3000
HOST=0.0.0.0
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=your-expense-parser-processor-id
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
OAUTH_ISSUER_URL=https://your-identity-provider.example.com/
OAUTH_AUDIENCE=https://receipt-api.example.com
OAUTH_JWKS_URL=https://your-identity-provider.example.com/.well-known/jwks.json
OAUTH_REQUIRED_SCOPE=receipts:scan
REDIS_URL=redis://127.0.0.1:6379
AUTH_CACHE_TTL_SECONDS=300
RECEIPT_LOW_CONFIDENCE_THRESHOLD=0.75
RECEIPT_RECONCILIATION_TOLERANCE=0.05
